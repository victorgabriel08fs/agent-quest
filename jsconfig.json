{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "capture/**/*",
    "scripts/**/*",
    "server/**/*",
    "shared/**/*",
    "test/**/*",
    "types/**/*",
    "web/**/*"
  ],
  "exclude": ["node_modules", "mockups", "tools"]
}
